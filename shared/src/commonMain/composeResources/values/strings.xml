    <!-- 7. Terms -->
    <string name="terms_title">Terms of use</string>
    <string name="terms_intro">Please read and accept the terms to start.</string>
    <string name="terms_summary_title">What we store, in short</string>
    <string name="terms_summary_1">Your email address, your name and your answers, to teach you and keep your progress.</string>
    <string name="terms_summary_2">A few facts about the password you choose (like its length). Never the password itself.</string>
    <string name="terms_summary_3">A short list of device settings (like dark mode and text size) to adapt the app.</string>
    <string name="terms_summary_4">Practice emails are off. We only send one if you ask for it at the end of a lesson.</string>
    <string name="terms_summary_5">You can see everything we store, and delete your account, at any time.</string>
    <string name="terms_read">Read the terms</string>
    <string name="terms_hide">Hide the terms</string>
    <string name="terms_version">Version %1$s</string>
    <string name="terms_body">ThisIsTea teaches you to spot scams with short lessons and practice. It is a free learning project made at LauzHack 2026. By using it, you agree to these terms.</string>
    <string name="terms_data_title">What we store and why</string>
    <string name="terms_data_body">We store your email address, your name, your answers and your progress, to teach you and to keep your progress safe. For the password you choose, we keep a few facts (like its length and whether it appears in known data breaches) for your password lesson, never the password itself. We keep a short list of device settings (like dark mode, text size and time zone) to adapt the app. We do not read your contacts and we do not track you on other sites. The page What we know about you lists everything we store, with the reason.</string>
    <string name="terms_practice_title">Practice emails</string>
    <string name="terms_practice_body">Only if you ask for it at the end of a lesson, we send one practice phishing email to the address you registered. You won't know exactly when it arrives or what it looks like; that is the test. It never asks for a password, and we only record whether its link was clicked and whether you reported it. You can pause or stop practice emails any time in Settings.</string>
    <string name="terms_use_title">Using the lessons</string>
    <string name="terms_use_body">The lessons use made-up companies, people and messages. Never send real passwords, codes or bank details to anyone because of something you saw in a lesson. If you think you have been scammed, contact your bank and the police.</string>
    <string name="terms_rights_title">Your choices</string>
    <string name="terms_rights_body">You can change your answers, pause or stop practice emails, and delete your account at any time in Settings. Deleting your account deletes everything we store about you.</string>
    <string name="terms_accept">I accept the terms of use</string>
    <string name="terms_start">Start</string>

