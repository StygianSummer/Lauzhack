# PRODUCTION settings for deploy/docker-compose.prod.yml. Copy to ../.env (repo root, gitignored)
# and replace every "changeme". Never commit .env.
# Local development needs no .env: use deploy/docker-compose.dev.yml or ./gradlew :server:run.
# A secret left at "changeme" is live and guessable: replace it.

# The public origin of the deployment, no trailing slash. Caddy serves the web app at
# PUBLIC_URL/ and the API at PUBLIC_URL/api, and gets the HTTPS certificate for this name.
# Its DNS record must point at this machine, with ports 80 and 443 open.
PUBLIC_URL=https://changeme.example.org

# Database (the compose file sets DATABASE_URL and DATABASE_USER for the app).
DATABASE_PASSWORD=changeme
# Postgres container password: must be the same value as DATABASE_PASSWORD.
POSTGRES_PASSWORD=changeme

# Extra CORS origins, comma-separated, only if another site calls this API (e.g. the GitHub Pages
# build: https://<org>.github.io). PUBLIC_URL is always allowed.
ALLOWED_ORIGINS=
# Optional overrides; by default PUBLIC_URL/ and PUBLIC_URL/api.
# APP_PUBLIC_URL=
# API_PUBLIC_URL=

# Mail. Empty SMTP_PASSWORD -> ConsoleMailer (mails printed to the log): sign-in then needs the
# code from the log, since the debug code is off below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=ThisIsTea

# Practice email: random delay after the opt-in press, in seconds; scheduler poll interval.
FIELD_DELAY_MIN_S=15
FIELD_DELAY_MAX_S=90
FIELD_POLL_S=5
# Reminder delay after a learner clicks a practice email, in seconds.
FIELD_REMIND_DELAY_S=300

# Secrets: long random strings (e.g. openssl rand -hex 32).
# ADMIN_KEY empty -> /admin endpoints disabled. CODE_PEPPER empty -> random per start.
ADMIN_KEY=changeme
CODE_PEPPER=changeme

# DEBUG ONLY: a fixed code that /auth/verify accepts in place of the emailed one. Keep "off" on a
# public server (empty would enable 426769 whenever SMTP_PASSWORD is empty).
DEV_VERIFY_CODE=off

RATE_LIMITS=on
APP_VERSION=prod

# Optional, offline AI variations only (not used by the server in MVP 0).
OPENROUTER_API_KEY=changeme
